# ═══════════════════════════════════════════════════════════
#  فرد سی‌ام‌اس — تنظیمات آپاچی
# ═══════════════════════════════════════════════════════════

# ─── نشانی‌های تمیز ─────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # اگر سایت در زیرشاخه نصب شده، مسیر آن را اینجا تنظیم کنید
    # RewriteBase /

    # فایل‌ها و پوشه‌های واقعی مستقیماً ارائه می‌شوند
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # پنل مدیریت و نقاط پایانی API از مسیریاب عبور نمی‌کنند
    RewriteRule ^(admin|api|assets|themes|uploads)/ - [L]

    # بقیه درخواست‌ها به کنترلر اصلی سپرده می‌شود
    RewriteRule . index.php [L]
</IfModule>

# ─── هدرهای امنیتی ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always unset X-Powered-By

    # این هدر فقط روی HTTPS معنا دارد؛ در صورت داشتن گواهی SSL فعال کنید
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ─── محافظت از فایل‌های حساس ───────────────────────────────
<FilesMatch "^(config\.php|config\.local\.php|\.htaccess|\.gitignore|composer\.json|package\.json)$">
    Require all denied
</FilesMatch>

# پوشه‌های داخلی نباید از بیرون خوانده شوند
#
# با RewriteRule نوشته شده و نه RedirectMatch: الگوی RedirectMatch به ریشه
# دامنه گره می‌خورد، پس در نصب زیرشاخه (مثل /mysite/) هرگز مطابقت نمی‌کرد و
# محافظت بی‌اثر می‌شد. مسیر RewriteRule نسبت به همین پوشه سنجیده می‌شود.
<IfModule mod_rewrite.c>
    RewriteRule ^(storage|includes|templates|tests)/ - [F,L]
</IfModule>

# لایه دوم: هر یک از این پوشه‌ها .htaccess اختصاصی خود را هم دارد تا اگر
# این فایل نادیده گرفته شود باز هم محافظت برجا بماند.

# ─── فشرده‌سازی ────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
</IfModule>

# ─── کش مرورگر ─────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # فایل‌های ظاهری با مهر نسخه (?v=…) صدا زده می‌شوند، پس کش طولانی
    # آن‌ها بی‌خطر است؛ با هر انتشار، آدرس عوض می‌شود و مرورگر نسخه تازه
    # را می‌گیرد. برای ماژول‌های ES که مهر نسخه را به import های خود
    # منتقل نمی‌کنند، قاعده بازبینی پایین‌تر تعریف شده است.
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"

    # صفحه‌های HTML همیشه تازه خوانده می‌شوند
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# ─── بازبینی ماژول‌های جاوااسکریپت پنل ───────────────────────
# مرورگر مهر نسخه‌ی فایل اصلی را به import های نسبی داخل آن منتقل نمی‌کند،
# پس بدون این قاعده، به‌روزرسانی یک ماژول تا پایان مدت کش به کاربر
# نمی‌رسید. no-cache یعنی «هر بار بپرس»؛ اگر تغییری نکرده باشد پاسخ ۳۰۴
# است که تقریباً بدون هزینه است.
<IfModule mod_headers.c>
    <FilesMatch "\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ─── صفحه‌های خطا ──────────────────────────────────────────
# ErrorDocument عمداً تنظیم نشده است: مسیر آن نسبت به ریشه دامنه تفسیر
# می‌شود، پس در نصب زیرشاخه به سایت دیگری اشاره می‌کرد. مسیریابی بالا
# همه درخواست‌ها را به index.php می‌سپارد و خود سیستم صفحه ۴۰۴ را
# نمایش می‌دهد.

# ─── جلوگیری از فهرست شدن محتوای پوشه‌ها ───────────────────
Options -Indexes
