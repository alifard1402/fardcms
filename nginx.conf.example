# ═══════════════════════════════════════════════════════════
#  فرد سی‌ام‌اس — نمونه تنظیمات nginx
#
#  این فایل را در پیکربندی سرور خود کپی و مقادیر server_name،
#  root و مسیر سوکت PHP-FPM را مطابق محیط خود تنظیم کنید.
# ═══════════════════════════════════════════════════════════

server {
    listen 80;
    server_name example.com www.example.com;
    root /var/www/fardcms;
    index index.php;

    charset utf-8;
    client_max_body_size 12M;   # کمی بیشتر از UPLOAD_MAX_SIZE

    # ─── هدرهای امنیتی ─────────────────────────────────────
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # ─── نشانی‌های تمیز ────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ─── اجرای PHP ─────────────────────────────────────────
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_hide_header X-Powered-By;
    }

    # ─── محافظت از فایل‌ها و پوشه‌های حساس ─────────────────
    location ~ ^/(storage|includes|templates|tests)/ {
        deny all;
        return 403;
    }

    location ~ ^/(config|config\.local)\.php$ {
        deny all;
        return 403;
    }

    # اجرای اسکریپت در پوشه آپلود به‌هیچ‌وجه مجاز نیست
    location ~ ^/uploads/.*\.(php|phtml|php[0-9]|cgi|pl|py|sh)$ {
        deny all;
        return 403;
    }

    location = /storage/installed.lock {
        deny all;
        return 403;
    }

    # ─── کش فایل‌های ثابت ──────────────────────────────────
    location ~* \.(css|js|jpg|jpeg|png|gif|webp|svg|woff2|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ─── فشرده‌سازی ────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/plain text/css text/xml application/javascript
               application/json application/rss+xml image/svg+xml;

    location = /favicon.ico { log_not_found off; access_log off; }

    # robots.txt به‌صورت پویا توسط index.php ساخته می‌شود (برای آدرس مطلق
    # نقشه سایت)، پس نباید به فایل ثابت نگاشت شود.
}
