# فایل‌های آپلودشده کاربران
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess

# فایل‌های موقت و قفل نصب
/storage/*
!/storage/.gitkeep
# فایل محافظت پوشه باید همراه پروژه ارائه شود
!/storage/.htaccess

# تنظیمات محلی
/config.local.php

# سیستم‌عامل و ویرایشگر
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# وابستگی‌های تست مرورگر (playwright) — در بسته انتشار نیست
# بدون اسلش پایانی، تا پیوند نمادین هم نادیده گرفته شود
node_modules

# تصویرهایی که تست‌های مرورگر در پوشه اجرا می‌ریزند
/*.png
